# LLM provider: Groq (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# Optional: override the model. Default is llama-3.3-70b-versatile.
# Other options: llama-3.1-8b-instant (faster), openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: fixed Flask session key (auto-generated if omitted)
FLASK_SECRET_KEY=replace-with-any-random-string
